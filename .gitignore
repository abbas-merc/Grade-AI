# ── Secrets ────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
firebase-service-account.json
*service-account*.json
google-services.json
# google-services.json (Android) MUST reach the EAS builder — the google-services
# Gradle plugin fails the build without it. It is safe to commit (the API key is
# restricted by package name + SHA; security is enforced by Firebase rules), so
# un-ignore the project copies that the build needs.
!/app/google-services.json
!/app/android/app/google-services.json

# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg
venv/
.venv/
env/
*.sqlite3
*.db

# ── Node / Expo ────────────────────────────────────────────────────────────────
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo

# ── OS ─────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── LaTeX typesetting engine ───────────────────────────────────────────────────
# Tectonic is a ~50 MB platform-specific binary installed on demand by
# backend/scripts/install_tectonic.py (and baked into the image by
# backend/Dockerfile). It must never be committed.
backend/tools/

# Licensed Century Gothic font files, if the school supplies them. Commercial
# Monotype fonts are not redistributable, so they stay out of the repo — drop
# them here locally, or point GA_CENTURY_GOTHIC_DIR at them.
backend/fonts/century_gothic/*
!backend/fonts/century_gothic/README.md

# ── Question-bank build artefacts ──────────────────────────────────────────────
# Source exam PDFs (22 MB) are read only by the offline build scripts; the
# running server never opens them, and .dockerignore already keeps them out of
# the image.
backend/papers/
# Intermediate crops. The PUBLISHED copies under backend/static/ are what the
# server serves and what the typesetter reads off disk, so only those are
# committed.
backend/scripts/question_parts/
backend/scripts/question_stems/
backend/scripts/question_figures/
backend/scripts/question_assets/
backend/scripts/question_snippets/
backend/scripts/pending_snippets/
backend/scripts/diagram_out/
backend/scripts/batch_review/
backend/scripts/question_bank_review/
backend/scripts/part_extraction/latex_test_output/
# Build intermediates of the part-level extraction. Only the three files the
# server actually loads at request time are committed (part_latex.json,
# part_figures.json, part_level_questions.json) plus the two small review lists.
backend/scripts/part_extraction/part_manifest.json
backend/scripts/part_extraction/part_tags.json
backend/scripts/part_extraction/part_dependencies.json
backend/scripts/part_extraction/review_lists.json

# Locally generated demo output.
/demo/
/demo_topic_algebra/
