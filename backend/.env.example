ANTHROPIC_API_KEY=your_anthropic_api_key_here
DATABASE_URL=sqlite:///./gradeai.db

# Firebase Admin auth — set ONE of the following.
# Local dev: path to your service account JSON file.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Railway / hosted: the entire service account JSON as a single string.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Require a valid Firebase ID token on every request. Leave true (the default)
# in production; set to false ONLY for local/dev to bypass token verification.
AUTH_REQUIRED=true

# --- Cost / abuse guardrails (all optional; sane defaults in usage_limits.py) ---
# Per-user daily caps on paid Anthropic calls. A compromised single account can
# never exceed these in a day.
# MAX_MARKINGS_PER_DAY_PER_USER=60
# MAX_GRADES_PER_DAY_PER_USER=200
# Global daily kill-switch across ALL users (backstops many-account abuse). If
# hit, new jobs pause until the next UTC day. Raise as the user base grows.
# MAX_MARKINGS_PER_DAY_GLOBAL=2000
# MAX_GRADES_PER_DAY_GLOBAL=5000
# Structural caps on a single job so one request can't be pathologically large.
# MAX_PAGES_PER_MARKING=20
# MAX_QUESTIONS_PER_MARKING=60
# Per-instance burst limiter (requests per uid per minute) on /grade.
# BURST_MAX_PER_MINUTE=20

# --- Web hardening (optional) ---
# Comma-separated CORS origins. Default "*" is safe here because auth is by
# Bearer token, not cookies. Pin to specific origins if a web client is added.
# CORS_ALLOW_ORIGINS=*
# Expose the interactive API docs (/docs, /redoc). Off in production by default;
# set true to re-enable.
# ENABLE_DOCS=false

# --- Paper typesetting (LaTeX) ------------------------------------------------
# Which renderer produces the downloadable question paper / mark scheme.
#   latex  (default) XeLaTeX typesetting — real maths notation, ruled answer
#                    space, the school's font. Needs the engine in the image
#                    (backend/Dockerfile installs it).
#   images           the previous reportlab renderer, which pastes a screenshot
#                    of each question. Instant rollback, no redeploy needed.
# GA_PDF_ENGINE=latex

# Absolute path to a directory holding the school's LICENSED Century Gothic
# files. Century Gothic is a commercial Monotype font and is NOT bundled; without
# this the pipeline falls back to TeX Gyre Adventor (the free URW Gothic revival)
# and says so in the X-GradeAI-Paper-Font response header.
# GA_CENTURY_GOTHIC_DIR=/opt/fonts/century-gothic

# Where the LaTeX engine lives, if it is not on PATH or in backend/tools/.
# TECTONIC_BIN=/usr/local/bin/tectonic
# Resource cache for the engine. Set in the image so a cold container never has
# to reach the network to typeset a paper.
# TECTONIC_CACHE_DIR=/opt/tectonic-cache

# Layout tuning — every constant in utils/latex/config.py can be overridden with
# a GA_LATEX_ prefix. The ones a school is most likely to want:
# GA_LATEX_ANSWER_LINES_PER_MARK=2      # ruled lines of working space per mark
# GA_LATEX_ANSWER_LINE_SKIP_MM=8.5      # vertical pitch of those lines
# GA_LATEX_PAGE_MARGIN_MM=20
# GA_LATEX_BODY_FONT_PT=11
# GA_LATEX_ENGINE_TIMEOUT_S=120         # a compile is killed after this

# Model used by the offline LaTeX extraction build script
# (scripts/build_latex_extraction.py). Not used at request time.
# GA_LATEX_EXTRACT_MODEL=claude-opus-5
