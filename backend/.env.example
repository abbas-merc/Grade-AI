ANTHROPIC_API_KEY=your_anthropic_api_key_here
DATABASE_URL=sqlite:///./gradeai.db

# Firebase Admin auth — set ONE of the following.
# Local dev: path to your service account JSON file.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Railway / hosted: the entire service account JSON as a single string.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Require a valid Firebase ID token on every request. Leave true (the default)
# in production; set to false ONLY for local/dev to bypass token verification.
AUTH_REQUIRED=true
