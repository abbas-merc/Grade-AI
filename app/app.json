{
  "expo": {
    "name": "GradeAI",
    "slug": "grade-ai",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "gradeai",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gradeai.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.gradeai.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "platforms": ["ios", "android"],
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      [
        "expo-image-picker",
        {
          "photosPermission": "GradeAI needs access to your photos to upload your answer.",
          "cameraPermission": "GradeAI needs access to your camera to photograph your answer."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c576733-eea6-4d0c-8f75-41ecf2e94346"
      }
    },
    "runtimeVersion": "1.0.1",
    "updates": {
      "url": "https://u.expo.dev/3c576733-eea6-4d0c-8f75-41ecf2e94346"
    }
  }
}
