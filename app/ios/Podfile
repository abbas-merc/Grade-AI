# react-native-firebase requires this when use_frameworks! is enabled (Firestore/static frameworks)
$RNFirebaseAsStaticFramework = true

require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

def ccache_enabled?(podfile_properties)
  # Environment variable takes precedence
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']
  
  # Fall back to Podfile properties
  podfile_properties['apple.ccacheEnabled'] == 'true'
end

ENV['RCT_NEW_ARCH_ENABLED'] ||= '0' if podfile_properties['newArchEnabled'] == 'false'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
ENV['RCT_USE_RN_DEP'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'

prepare_react_native_project!

target 'GradeAI' do
  use_frameworks! :linkage => :static
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(\'expo/bin/autolinking\')',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )

    # fmt 11.x enables consteval compile-time format-string checking for modern
    # clang. Apple clang 21 (Xcode 26) rejects fmt's consteval basic_format_string
    # as "not a constant expression", breaking fmt/folly/React built from source
    # (ios.buildReactNativeFromSource). base.h defines FMT_USE_CONSTEVAL
    # unconditionally, so a -D flag can't override it — patch the header to force
    # the non-consteval fallback (functionally identical, just no compile-time check).
    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      original = File.read(fmt_base)
      patched = original.gsub("#  define FMT_USE_CONSTEVAL 1", "#  define FMT_USE_CONSTEVAL 0")
      File.write(fmt_base, patched) if patched != original
    end

    # macOS (Sequoia/Tahoe) stamps a kernel-managed `com.apple.provenance`
    # xattr on files that cannot be removed from userspace. codesign rejects it
    # with "resource fork, Finder information, or similar detritus not allowed".
    # With use_frameworks! :static, pod frameworks are LINKED into the app, not
    # embedded, so signing them is unnecessary — disable it to dodge the failure.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        # Xcode's Clang explicitly-built modules (EBM) are strict about module
        # ownership and reject React-Core's textual headers with "declaration of
        # 'RCTBridgeModule' must be imported from module 'RNFBApp...' before it is
        # required", breaking the RNFBFirestore/RNFBApp Obj-C modules. Fall back
        # to implicit modules, the mode React Native + Firebase have always used.
        config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
        # React-Core is exposed as plain textual headers, not a Clang module, so
        # RNFBApp/RNFBFirestore/RNFBStorage include <React/...> non-modularly
        # inside their framework modules. Permit it instead of erroring
        # (-Werror,-Wnon-modular-include-in-framework-module -> could not build module 'RNFBApp').
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end

    # The app target inherits these generated xcconfigs; force the same settings
    # so importing the RNFB modules from the app doesn't re-trigger either error.
    Dir.glob(File.join(installer.sandbox.root, 'Target Support Files', 'Pods-*', '*.xcconfig')).each do |xcconfig|
      File.open(xcconfig, 'a') do |f|
        f.puts 'CLANG_ENABLE_EXPLICIT_MODULES = NO'
        f.puts 'CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES'
      end
    end
  end
end
